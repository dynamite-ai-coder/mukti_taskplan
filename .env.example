# ============================================================
# DeepSeek V4 — 5 independent accounts
# Copy to .env and fill with real keys (never commit .env)
#   cp .env.example .env
# Each account maps to provider deepseek-account-N in opencode.json
# ============================================================
DEEPSEEK_KEY_1=
DEEPSEEK_KEY_2=
DEEPSEEK_KEY_3=
DEEPSEEK_KEY_4=
DEEPSEEK_KEY_5=

# Optional overrides
# A2A registry HTTP port (default 8788)
A2A_REGISTRY_PORT=8788
# Browser A2A server port (default 8789)
BROWSER_A2A_PORT=8789
# Shared secret for A2A/AACP envelope signing (change in production)
A2A_SECRET=local-dev-secret-change-me
# Set true to reject unsigned A2A envelopes
A2A_REQUIRE_SIGNATURES=false
# Browser MCP launch tuning
# BROWSER_NO_SANDBOX=true       # force --no-sandbox (auto-on when running as root)
# BROWSER_MCP_TIMEOUT_MS=90000  # per browser tool-call timeout
# Directory for side-channel logs (default ./logs)
AACP_LOG_DIR=
