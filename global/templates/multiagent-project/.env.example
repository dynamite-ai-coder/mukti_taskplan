# ============================================================
# Host project environment.
#
# The planner model + API key come from the HOST'S GLOBAL OpenCode
# config (~/.config/opencode/opencode.json providers), not from here.
# This file only configures the A2A registry and side-channel logs.
#   cp .env.example .env
# ============================================================

# A2A registry HTTP port (default 8788)
A2A_REGISTRY_PORT=8788
# Shared secret for A2A/AACP envelope signing (change in production)
A2A_SECRET=local-dev-secret-change-me
# Set true to reject unsigned A2A envelopes
A2A_REQUIRE_SIGNATURES=false
# Directory for side-channel logs (default ./logs)
AACP_LOG_DIR=
