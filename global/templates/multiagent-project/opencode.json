{
  "$schema": "https://opencode.ai/config.json",
  "permission": { "external_directory": "allow" },
  "default_agent": "planner",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "a2a-registry": {
      "type": "local",
      "command": ["node", "{env:HOME}/.config/opencode/scripts/a2a-registry-mcp.js"],
      "enabled": true,
      "timeout": 15000
    },
    "aacp-codec": {
      "type": "local",
      "command": ["node", "{env:HOME}/.config/opencode/scripts/aacp-codec-mcp.js"],
      "enabled": true,
      "timeout": 15000
    },
    "ail-codec": {
      "type": "local",
      "command": ["node", "{env:HOME}/.config/opencode/scripts/ail-codec-mcp.js"],
      "enabled": true,
      "timeout": 15000
    }
  }
}
